{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the application with access permissions and daily trial counters.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The Firebase Auth UID." },
        "email": { "type": "string", "format": "email", "description": "The user's email address." },
        "displayName": { "type": "string", "description": "The user's display name." },
        "photoURL": { "type": "string", "description": "The user's profile photo URL." },
        "role": { "type": "string", "enum": ["user", "admin"], "description": "The user's role." },
        "subscription": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["free", "premium"] },
            "expiresAt": { "type": "integer", "description": "Timestamp in ms" },
            "token": { "type": "string", "description": "User specific access token" }
          }
        },
        "dailyGenerations": { "type": "integer", "description": "Number of trial generations today." },
        "lastGenerationDate": { "type": "string", "description": "Date of last generation in YYYY-MM-DD format." }
      },
      "required": ["uid", "email"]
    },
    "GlobalConfig": {
      "title": "GlobalConfig",
      "description": "Global API key and model specifications configured by the admin.",
      "type": "object",
      "properties": {
        "activeProvider": { "type": "string", "enum": ["gemini", "deepseek"] },
        "deepseekApiKey": { "type": "string" },
        "geminiApiKey": { "type": "string" },
        "customModel": { "type": "string" },
        "customEndpoint": { "type": "string" }
      }
    },
    "Analysis": {
      "title": "Analysis",
      "description": "An image analysis result.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The user's UID." },
        "cameraAngle": { "type": "string" },
        "backgroundSetting": { "type": "string" },
        "characterPose": { "type": "string" },
        "emotionalVibe": { "type": "string" },
        "locationDetails": { "type": "string" },
        "masterPrompt": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "masterPrompt", "createdAt"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": { "$ref": "User" },
      "description": "User profiles."
    },
    "/admins/{uid}": {
      "schema": { "type": "object", "properties": { "email": { "type": "string" } } },
      "description": "Admin list for role check."
    },
    "/config/global": {
      "schema": { "$ref": "GlobalConfig" },
      "description": "Global Admin configured API keys and models."
    },
    "/users/{uid}/analyses/{analysisId}": {
      "schema": { "$ref": "Analysis" },
      "description": "User image analyses."
    }
  }
}
